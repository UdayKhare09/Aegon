@PACKAGE_INIT@

# Recreate the Aegon::Ext::* dependency targets that the exported Aegon targets link
# against (Threads, liburing, glaze, OpenSSL, PostgreSQL, SQLite3, libdeflate, nghttp2,
# nghttp3, ngtcp2, protobuf), with the same discovery Aegon's own build uses.
if(NOT TARGET Aegon::Ext::Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/AegonDependencies.cmake")
endif()

# Import the Aegon targets
include("${CMAKE_CURRENT_LIST_DIR}/AegonTargets.cmake")

check_required_components(Aegon)
