# Maintainer: Uday Khare <udaykhare77@gmail.com>
pkgname=aegon
pkgver=0.2.1
pkgrel=1
pkgdesc="High-Performance C++23 Asynchronous Web & Data Framework"
arch=('x86_64')
url="https://github.com/UdayKhare09/Aegon"
license=('MIT')
depends=(
    'liburing'
    'openssl'
    'sqlite'
    'postgresql-libs'
    'libnghttp2'
    'libngtcp2'
    'libnghttp3'
    'libdeflate'
    'glaze'
)
makedepends=('cmake' 'ninja' 'gcc' 'git')
options=('staticlibs' '!strip' '!lto')
build() {
    cmake -B "${srcdir}/build" -S "${startdir}/../.." -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DAEGON_BUILD_TESTS=OFF \
        -DAEGON_BUILD_SAMPLES=OFF \
        -DAEGON_BUILD_BENCHMARKS=OFF
    cmake --build "${srcdir}/build"
}

package() {
    DESTDIR="${pkgdir}" cmake --install "${srcdir}/build"
}
