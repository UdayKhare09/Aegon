# Maintainer: Uday Khare <udaykhare77@gmail.com>
pkgname=aegon
pkgver=0.1.0.alpha2
pkgrel=1
pkgdesc="High-Performance C++23 Asynchronous Web & Data Framework"
arch=('x86_64')
url="https://github.com/UdayKhare09/Aegon"
license=('MIT')
depends=(
    'liburing'
    'glaze'
    'openssl'
    'sqlite'
    'postgresql-libs'
    'nghttp2'
    'ngtcp2'
    'nghttp3'
    'libdeflate'
)
makedepends=('cmake' 'ninja' 'gcc' 'git')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/UdayKhare09/Aegon/archive/refs/tags/v0.1.0-alpha2.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -B build -S "${srcdir}/Aegon-0.1.0-alpha2" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DAEGON_BUILD_TESTS=OFF \
        -DAEGON_BUILD_SAMPLES=OFF \
        -DAEGON_BUILD_BENCHMARKS=OFF
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
}
