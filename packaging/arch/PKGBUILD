# Maintainer: Uday Khare <udaykhare77@gmail.com>
pkgname=aegon
pkgver=0.1.0_a2
pkgrel=1
pkgdesc="High-Performance C++26 Asynchronous Web & Data Framework"
arch=('x86_64')
url="https://github.com/UdayKhare09/Aegon"
license=('Apache-2.0')
depends=(
    'liburing'
    'glaze'
    'openssl'
    'sqlite'
    'postgresql-libs'
    'nghttp2'
    'ngtcp2'
    'nghttp3'
)
makedepends=('cmake' 'ninja' 'gcc>=14' 'git')

build() {
    cmake -B build -S "${srcdir}/../.." -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure -R "version|simd_string|foundational_types|dto_validation|simd_router|radix_router|advanced_io|redis_protocol|sql_schema|sql_query_builder|sql_transaction|sql_drivers|orm_cache|orm_advanced|sql_tx_cache_parity|error_handling|middleware|cors|security_headers|cookie|jwt|auth_middleware|rbac_guard|jwks|http_client|service_registry|config|gateway"
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
}
